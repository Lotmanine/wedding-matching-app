QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

CHARGILY_API_KEY=
CHARGILY_SECRET_KEY=
CHARGILY_WEBHOOK_SECRET=
CHARGILY_MODE=test

SENTRY_LARAVEL_DSN=
