APP_NAME="Zawaj Pro (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_URL=https://staging.zawajpro.dz
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Algiers

LOG_CHANNEL=stack
LOG_STACK=daily,zawaj_structured
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=
