APP_NAME="Wedding Matching App (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_URL=https://staging.wedding-app.oldev.site
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Africa/Algiers

LOG_CHANNEL=stack
LOG_STACK=daily,app_structured
