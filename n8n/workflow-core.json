            "id": "bd0e7bdc-0000-4000-8000-be61e8c1465c",
            "name": "Fetch Ranking Candidates",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                420,
                400
