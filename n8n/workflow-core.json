            "retryOnFail": true,
            "maxTries": 3,
            "waitBetweenTries": 2000
        },
        {
            "parameters": {
                "language": "javaScript",
                "jsCode": "// $input here is the HTTP response of Fetch Ranking Candidates: the job metadata\n// is read from the pivot node, paired automatically by n8n.\nconst meta = $('Prepare Matching Job').item.json;\nconst ctx  = $json.data || $json;\nconst candidates = ctx.candidates || [];\n// Providers per round: set in /admin/settings, sent by Laravel.\nconst perRound = Number(ctx.providers_per_round || 3);\n\nif (!candidates.length) { return null; }   // no eligible provider → stop\n\nconst system = [\n  'You are the matching expert of Wedding Matching App, a wedding-services marketplace (demo project with example cities in the USA and France).',\n  'You rank candidate providers for one specific request and return the BEST ones first.',\n  '',\n  'Criteria, by order of importance:',\n  '1. Location (same_city > adjacent > far).',\n  \"2. Budget fit: min_price / max_price against the couple's budget.\",\n  '3. Reliability: acceptance_rate, then rating_avg weighted by rating_count.',\n  '4. Experience: years_experience and leads_accepted.',\n  '5. A language shared with the couple, when known.',\n  '',\n  'Only return ids present in the candidate list.',\n  `Return at most ${perRound} ids.`,\n].join('\\n');\n\nconst user = [\n  `Requested service: ${meta.service_type}`,\n  `Couple's city: ${meta.city_code}`,\n  `District: ${(meta.couple || {}).district || 'not specified'}`,\n  `Wedding date: ${(meta.wedding || {}).date || 'not specified'}`,\n  `Total budget: ${(meta.wedding || {}).budget_range || 'not specified'}`,\n  `Guest count: ${(meta.wedding || {}).guest_count || 'not specified'}`,\n  `Round: ${meta.target_round}`,\n  '',\n  'Candidates (JSON):',\n  JSON.stringify(candidates, null, 2),\n].join('\\n');\n\nreturn {\n  json: {\n    service_uid:  meta.service_uid,\n    target_round: meta.target_round,\n    anthropic_body: {\n      model: 'claude-sonnet-5',\n      max_tokens: 1024,\n      system,\n      messages: [{ role: 'user', content: user }],\n      // Structured output: the response is guaranteed to match the schema.\n      output_config: {\n        format: {\n          type: 'json_schema',\n          schema: {\n            type: 'object',\n            properties: {\n              ranked_provider_ids: { type: 'array', items: { type: 'integer' } },\n              reasoning:           { type: 'string' },\n            },\n            required: ['ranked_provider_ids', 'reasoning'],\n            additionalProperties: false,\n          },\n        },\n      },\n    },\n  },\n};",
                "mode": "runOnceForEachItem"
            },
            "id": "e49e50e8-0000-4000-8000-4af1c22440f0",
