                "language": "javaScript",
                "jsCode": "// service_request.round_timed_out only carries identifiers:\n// { service_uid, previous_round, current_status }. Keep the uid and read the\n// real state from the API right after.\nreturn $input.all()\n  .map(i => (i.json.data || {}).service_uid)\n  .filter(Boolean)\n  .map(uid => ({ json: { service_uid: uid, trigger: 'round_timed_out' } }));"
            },
