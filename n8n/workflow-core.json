            "id": "d71894c7-0000-4000-8000-c517c72bebfd",
            "name": "Claude Rank",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                860,
                400
            ],
            "retryOnFail": true,
            "maxTries": 3,
            "waitBetweenTries": 5000
        },
        {
            "parameters": {
                "language": "javaScript",
                "jsCode": "const meta = $('Prepare Matching Job').item.json;\nconst resp = $json;\n\nif (resp && resp.type === 'error') {\n  throw new Error('Anthropic API error: ' + JSON.stringify(resp.error || {}));\n}\n\nconst block = (resp.content || []).find(b => b && b.type === 'text');\nif (!block || !block.text) { throw new Error('Empty Claude response'); }\n\n// Thanks to output_config.format, the API guarantees valid JSON.\nlet parsed;\ntry {\n  parsed = JSON.parse(block.text);\n} catch (e) {\n  throw new Error('Claude returned invalid JSON: ' + String(block.text).slice(0, 200));\n}\n\nconst ids = (parsed.ranked_provider_ids || []).map(Number).filter(Number.isInteger);\nif (!ids.length) { throw new Error('Claude returned no ranked provider ids'); }\n\n// Safety net: never send a provider already notified or refused, even if the model proposes one.\nconst banned = new Set((meta.excluded_provider_ids || []).map(Number));\nconst clean = ids.filter(id => !banned.has(id));\nif (!clean.length) { throw new Error('All ranked providers were already notified'); }\n\n// Set in /admin/settings, sent by Laravel with the candidates.\nconst cand = $('Fetch Ranking Candidates').item.json;\nconst perRound = Number((cand.data || cand).providers_per_round || 3);\n\nreturn {\n  json: {\n    service_uid:  meta.service_uid,\n    target_round: meta.target_round,\n    provider_ids: clean.slice(0, perRound),\n    reasoning:    String(parsed.reasoning || ''),\n  },\n};",
                "mode": "runOnceForEachItem"
            },
