        {
            "parameters": {
                "language": "javaScript",
                "jsCode": "const snap = $json.data;\nconst sev = snap.severity;\nconst icon  = sev === 'critical' ? '\\u{1F6A8}' : '\\u26A0\\uFE0F';\nconst label = sev === 'critical' ? 'CRITICAL' : 'WARN';\n\nconst rows = [\n  ['Stuck matching',         (snap.stuck_matching      || []).length],\n  ['Failed webhooks (24h)',  (snap.failed_webhooks_24h || []).length],\n  ['Failed WhatsApp (24h)',  (snap.failed_whatsapp_24h || []).length],\n  ['n8n errors (24h)',       (snap.n8n_errors_24h      || []).length],\n];\n\nconst tr = rows.map(([k, v]) =>\n  `<tr><td style=\"padding:6px 12px;border-bottom:1px solid #e5e7eb\">${k}</td>` +\n  `<td style=\"padding:6px 12px;border-bottom:1px solid #e5e7eb;text-align:right;font-weight:600\">${v}</td></tr>`\n).join('');\n\nconst html = `<!doctype html>\n<html><body style=\"font-family:-apple-system,Segoe UI,Roboto,sans-serif;color:#1f2937;padding:24px\">\n  <h2 style=\"margin:0 0 12px 0\">${icon} Wedding Matching App \\u2014 ${label} (${snap.run_at})</h2>\n  <table style=\"border-collapse:collapse;min-width:360px\">${tr}</table>\n  <p style=\"margin-top:16px\"><a href=\"${$env.LARAVEL_APP_URL || $env.LARAVEL_API_URL}/admin\">Open the admin dashboard</a></p>\n</body></html>`;\n\nreturn [{ json: {\n  to: $env.ADMIN_ALERT_EMAIL,\n  subject: `${icon} Wedding Matching App \\u2014 ${label}`,\n  html,\n  snapshot: snap,\n} }];"
            },
