            "id": "6c0e4d92-0000-4000-8000-1b7a9f35c8e1",
            "name": "Compute HMAC",
            "type": "n8n-nodes-base.crypto",
            "typeVersion": 1,
            "position": [
                -1010,
                240
            ]
        },
        {
            "parameters": {
                "language": "javaScript",
                "jsCode": "// The expected signature comes from the Compute HMAC node (Crypto) over the RAW\n// request body: the crypto module is not allowed in Code nodes (n8n 2.x task\n// runners), and re-serialising the JSON would not give back the signed bytes.\nconst req = $input.first().json;\nconst headers = req.headers || {};\nconst received = String(headers['x-wedding-signature'] || '').trim().toLowerCase();\nconst expected = String(req.expected_signature || '').toLowerCase();\n\n// Constant-time comparison, no dependency.\nlet diff = received.length ^ expected.length;\nfor (let i = 0; i < expected.length; i++) {\n  diff |= (received.charCodeAt(i) || 0) ^ expected.charCodeAt(i);\n}\nif (!expected || diff !== 0) { throw new Error('Invalid X-Wedding-Signature'); }\n\nreturn [{ json: typeof req.body === 'string' ? JSON.parse(req.body) : req.body }];"
            },
