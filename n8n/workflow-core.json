            "id": "c08f9d71-0000-4000-8000-295cd04fa367",
            "name": "GET Receipt PDF",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                -240,
                700
            ],
            "retryOnFail": true,
            "maxTries": 3,
            "waitBetweenTries": 2000
        },
        {
            "parameters": {
                "language": "javaScript",
                "jsCode": "const data = $('Verify HMAC').item.json.data;\nconst lang = String(data.preferred_language || 'en').toLowerCase() === 'fr' ? 'fr' : 'en';\n\nconst credits = Number(data.credits_granted ?? data.unlocks ?? 0);\nconst currency = data.currency || 'USD';\nconst amount = new Intl.NumberFormat(lang === 'fr' ? 'fr-FR' : 'en-US', { style: 'currency', currency, maximumFractionDigits: 0 }).format(Number(data.amount ?? 0));\nconst packName = data.pack_name || '';\nconst uid = data.purchase_uid;\n\nconst t = lang === 'fr' ? {\n  subject: `Reçu de paiement \\u2014 ${uid}`,\n  greeting: data.provider_name ? `Bonjour ${data.provider_name},` : 'Bonjour,',\n  intro: 'Merci pour votre achat de crédits sur Wedding Matching App (projet de démonstration).',\n  summary: `${credits} crédit${credits > 1 ? 's' : ''} ajouté${credits > 1 ? 's' : ''} à votre solde pour ${amount}.`,\n  pack: packName ? `Pack : ${packName}` : '',\n  attachment: 'Le reçu au format PDF est en pièce jointe.',\n  closing: 'Wedding Matching App',\n} : {\n  subject: `Payment receipt \\u2014 ${uid}`,\n  greeting: data.provider_name ? `Hello ${data.provider_name},` : 'Hello,',\n  intro: 'Thank you for buying credits on Wedding Matching App (demo project).',\n  summary: `${credits} credit${credits === 1 ? '' : 's'} added to your balance for ${amount}.`,\n  pack: packName ? `Pack: ${packName}` : '',\n  attachment: 'The PDF receipt is attached.',\n  closing: 'Wedding Matching App',\n};\n\nconst html = `<!doctype html>\n<html><body style=\"font-family:-apple-system,Segoe UI,Roboto,sans-serif;color:#1f2937;padding:24px\">\n  <p>${t.greeting}</p>\n  <p>${t.intro}</p>\n  <p style=\"font-weight:600\">${t.summary}</p>\n  ${t.pack ? `<p>${t.pack}</p>` : ''}\n  <p>${t.attachment}</p>\n  <p style=\"margin-top:24px\">${t.closing}</p>\n</body></html>`;\n\nreturn [{\n  json: { to: data.provider_email, subject: t.subject, html, purchase_uid: uid },\n  binary: $input.first().binary,\n}];"
            },
