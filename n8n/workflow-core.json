        {
            "parameters": {
                "language": "javaScript",
                "jsCode": "// Pivot node: reads the FRESH state from the API (not the webhook snapshot,\n// which can be replayed or late) and decides the mode. Same logic for a new\n// request (current_round = 0 → round 1) and a timed-out round (current_round =\n// N → round N+1, or opening to the marketplace).\nconst sr = ($json && $json.data) ? $json.data : null;\nif (!sr || !sr.service_uid) { return null; }   // 404 / unexpected response → drop the item\n\n// Terminal statuses: nothing left to do.\nconst TERMINAL = ['accepted', 'expired', 'deleted', 'open_marketplace'];\nif (TERMINAL.includes(String(sr.status))) { return null; }\n\nconst wed = sr.wed_request || {};\nconst currentRound = Number(sr.current_round || 0);\nconst maxRounds = Number($env.WEDDING_MAX_ROUNDS || 3);\n\nconst base = {\n  service_uid:  sr.service_uid,\n  service_type: sr.service_type,\n  city_code:    (wed.couple || {}).city_code,\n  status:       sr.status,\n  couple:       wed.couple  || {},\n  wedding:      wed.wedding || {},\n};\n\n// Every round used → open to the marketplace.\nif (currentRound >= maxRounds) {\n  return { json: { ...base, mode: 'force_open', target_round: currentRound, excluded_provider_ids: [] } };\n}\n\n// Never notify the same provider twice.\nconst excluded = Array.from(new Set([\n  ...(sr.all_notified_provider_ids || []),\n  ...(sr.refused_by_provider_ids   || []),\n  ...(sr.unlocked_by_user_id ? [sr.unlocked_by_user_id] : []),\n].map(Number)));\n\nreturn { json: { ...base, mode: 'next_round', target_round: currentRound + 1, excluded_provider_ids: excluded } };",
                "mode": "runOnceForEachItem"
            },
