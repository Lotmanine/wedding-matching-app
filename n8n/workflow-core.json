        {
            "parameters": {
                "language": "javaScript",
                "jsCode": "// wed_request.submitted → one matching job per requested service.\nconst out = [];\nfor (const it of $input.all()) {\n  const d = it.json.data || {};\n  for (const sr of (d.service_requests || [])) {\n    if (sr.service_uid) out.push({ json: { service_uid: sr.service_uid, trigger: 'wed_submitted' } });\n  }\n}\nreturn out;"
            },
