            "id": "a93f6b07-0000-4000-8000-5d18e2c4096b",
            "name": "Compute Meta HMAC",
            "type": "n8n-nodes-base.crypto",
            "typeVersion": 1,
            "position": [
                -770,
                1140
            ]
        },
        {
            "parameters": {
                "language": "javaScript",
                "jsCode": "// Meta signs the RAW body (X-Hub-Signature-256: sha256=<hex>) with the App secret\n// from /admin/whatsapp. The expected HMAC comes from Compute Meta HMAC (Crypto node).\nconst req = $('Meta Events (POST)').first().json;\nconst cfg = $input.first().json || {};\n\nif (!((cfg.data || {}).app_secret)) {\n  throw new Error('WhatsApp app secret is not configured in /admin/whatsapp');\n}\n\nconst headers = req.headers || {};\nconst received = String(headers['x-hub-signature-256'] || '').replace(/^sha256=/i, '').trim().toLowerCase();\nconst expected = String(cfg.expected_signature || '').toLowerCase();\n\n// Constant-time comparison, no dependency.\nlet diff = received.length ^ expected.length;\nfor (let i = 0; i < expected.length; i++) {\n  diff |= (received.charCodeAt(i) || 0) ^ expected.charCodeAt(i);\n}\nif (!expected || !received || diff !== 0) { throw new Error('Invalid Meta signature'); }\n\nreturn [{ json: typeof req.body === 'string' ? JSON.parse(req.body) : req.body }];"
            },
            "id": "5b74df44-0000-4000-8000-451c9ea71d3a",
            "name": "Verify Meta Signature",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                -880,
                1000
            ]
        },
        {
            "parameters": {
                "language": "javaScript",
                "jsCode": "const out = [];\nfor (const it of $input.all()) {\n  const body = it.json;\n  for (const entry of (body.entry || [])) {\n    for (const change of (entry.changes || [])) {\n      if (change.field !== 'messages') continue;\n      const v = change.value || {};\n\n      for (const msg of (v.messages || [])) {\n        const isButton      = msg.type === 'button'      && msg.button && msg.button.payload;\n        const isInteractive = msg.type === 'interactive' && msg.interactive && msg.interactive.button_reply;\n\n        if (isButton || isInteractive) {\n          out.push({ json: {\n            kind: 'button_message',\n            wa_message_id: msg.id,\n            from_phone: '+' + msg.from,\n            timestamp: String(msg.timestamp),\n            button_payload: isButton ? msg.button.payload : msg.interactive.button_reply.id,\n            button_text:    isButton ? (msg.button.text || '') : (msg.interactive.button_reply.title || ''),\n            in_reply_to: (msg.context && msg.context.id) || null,\n          } });\n        } else {\n          out.push({ json: { kind: 'other', wa_message_id: msg.id, type: msg.type } });\n        }\n      }\n\n      for (const st of (v.statuses || [])) {\n        out.push({ json: {\n          kind: 'status',\n          wa_message_id: st.id,\n          status: st.status,\n          timestamp: String(st.timestamp),\n          recipient_id: '+' + st.recipient_id,\n          error: (st.errors && st.errors[0])\n            ? `${st.errors[0].code}: ${st.errors[0].title || ''}`.slice(0, 500)\n            : null,\n        } });\n      }\n    }\n  }\n}\nreturn out;"
            },
