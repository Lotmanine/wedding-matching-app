        },
        {
            "parameters": {
                "language": "javaScript",
                "jsCode": "const out = [];\nfor (const it of $input.all()) {\n  const p = it.json.data || {};\n  for (const r of (p.recipients || [])) {\n    if (!r.phone_e164) continue;\n    out.push({ json: {\n      event: it.json.event,\n      service_request_uid: p.service_request_id,\n      template_intent: p.template_intent || 'round_teaser',\n      role: 'provider',\n      provider_id: r.provider_id,\n      to_phone: r.phone_e164,\n      lang: r.preferred_language || 'en',\n      vars: {\n        couple_first_name: (p.couple || {}).first_name,\n        city:              (p.couple || {}).city,\n        service_type:      (p.service || {}).type,\n        budget_hint:       (p.service || {}).budget_hint,\n        event_date:        (p.service || {}).event_date,\n        expires_at:        p.expires_at,\n      },\n      buttons: r.buttons || [],\n    } });\n  }\n}\nreturn out;"
            },
            "id": "a4b14967-0000-4000-8000-580d5c69d9a9",
            "name": "Fan Round Recipients",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                -440,
                60
            ]
        },
        {
            "parameters": {
                "language": "javaScript",
                "jsCode": "const out = [];\nfor (const it of $input.all()) {\n  const p = it.json.data || {};\n  const w = p.winner || {};\n  const c = p.couple || {};\n  const s = p.service || {};\n\n  if (w.phone_e164) {\n    out.push({ json: {\n      event: it.json.event,\n      service_request_uid: p.service_request_id,\n      template_intent: 'winner_confirmation_provider',\n      role: 'provider',\n      provider_id: w.provider_id,\n      to_phone: w.phone_e164,\n      lang: w.preferred_language || 'ar',\n      vars: {\n        couple_first_name: c.first_name,\n        couple_phone:      c.phone_e164,\n        service_type:      s.type,\n        event_date:        s.event_date,\n      },\n      buttons: [],\n    } });\n  }\n\n  if (c.phone_e164) {\n    out.push({ json: {\n      event: it.json.event,\n      service_request_uid: p.service_request_id,\n      template_intent: 'winner_confirmation_couple',\n      role: 'couple',\n      provider_id: null,\n      to_phone: c.phone_e164,\n      lang: c.preferred_language || 'fr',\n      vars: {\n        provider_business_name: w.business_name,\n        provider_phone:         w.phone_e164,\n        service_type:           s.type,\n      },\n      buttons: [],\n    } });\n  }\n}\nreturn out;"
            },
            "id": "88a69035-0000-4000-8000-82c2f11e1038",
            "name": "Fan Winner + Couple",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
