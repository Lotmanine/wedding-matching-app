        {
            "parameters": {
                "language": "javaScript",
                "jsCode": "// Groups results in batches of 100 at most: the Laravel endpoint validates\n// `results` at 200 and a marketplace broadcast can exceed that.\nconst CHUNK = 100;\nconst rows = $input.all().map(i => i.json);\nif (!rows.length) { return []; }\n\nconst out = [];\nfor (let i = 0; i < rows.length; i += CHUNK) {\n  const slice = rows.slice(i, i + CHUNK);\n  out.push({ json: {\n    event: slice[0].event,\n    service_request_id: slice[0].service_request_id,\n    results: slice.map(r => ({\n      role:                 r.role,\n      recipient_phone_e164: r.recipient_phone_e164,\n      template_intent:      r.template_intent,\n      provider_id:          r.provider_id,\n      wa_message_id:        r.wa_message_id,\n      status:               r.status,\n      error:                r.error,\n    })),\n  } });\n}\nreturn out;"
            },
