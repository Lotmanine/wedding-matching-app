        {
            "parameters": {
                "language": "javaScript",
                "jsCode": "// The HTTP node REPLACES the item: read the source from Map to Meta Template\n// and take only the wamid or the error from the response.\nconst src  = $('Map to Meta Template').item.json;\nconst resp = $json || {};\n\nconst wamid = (resp.messages && resp.messages[0] && resp.messages[0].id) || null;\nconst err = resp.error\n  ? `${resp.error.code || 'error'}: ${String(resp.error.message || '').slice(0, 400)}`\n  : null;\n\nreturn {\n  json: {\n    event:                src.event,\n    service_request_id:   src.service_request_uid,\n    template_intent:      src.template_intent,\n    role:                 src.role,\n    provider_id:          src.provider_id,\n    recipient_phone_e164: src.to_phone,\n    wa_message_id:        wamid,\n    status:               wamid ? 'sent' : 'failed',\n    error:                wamid ? null : (err || 'unknown Meta error'),\n  },\n};",
                "mode": "runOnceForEachItem"
            },
            "id": "0576969e-0000-4000-8000-86a700357047",
            "name": "Normalize Result",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
