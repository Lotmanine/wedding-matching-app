# Wedding Matching App: n8n variables
# Copy to .env.n8n and fill in, or enter the same keys in the environment of
# your n8n instance. The nodes read them through $env.NAME.

# Laravel
# As seen FROM the n8n container. With local Docker: host.docker.internal, not 127.0.0.1.
# In production: https://your-domain.example
LARAVEL_API_URL=http://host.docker.internal:8000

# Public URL used in the links of alert e-mails (optional: falls back to LARAVEL_API_URL).
LARAVEL_APP_URL=http://127.0.0.1:8000

# Sanctum token with the n8n-service ability:
#   php artisan wedding:create-api-token --name=n8n-service --abilities=n8n-service
LARAVEL_API_TOKEN=

# Shared HMAC secret, Laravel to n8n. Must be IDENTICAL to the "secret" field of each
# endpoint created in /admin/webhooks, and to WEDDING_WEBHOOK_SECRET in Laravel.
#   php -r "echo bin2hex(random_bytes(16));"
WEDDING_WEBHOOK_SECRET=

# Claude (provider ranking, wedding-core workflow)
# Model: claude-sonnet-5, set in the "Build Claude Prompt" node.
ANTHROPIC_API_KEY=

# Must match config/wedding.php in Laravel.
WEDDING_MAX_ROUNDS=3
# Not read by the workflows: they receive providers_per_round from the API.
WEDDING_PROVIDERS_PER_ROUND=3

# Meta WhatsApp Cloud API (wedding-whatsapp workflow)
# No variables here: the phone number ID, access token, verify token and app secret
# are entered in Laravel (/admin/whatsapp). The workflow reads them on every run
# through GET /api/v1/n8n/whatsapp-config, using LARAVEL_API_TOKEN.

# Monitoring (wedding-core workflow, 30-minute schedule)
ADMIN_ALERT_EMAIL=
WEDDING_FROM_EMAIL=noreply@example.com

# Shared error handler
# Not read by the workflows: the handler builds this URL from LARAVEL_API_URL.
N8N_ERROR_WEBHOOK_URL=http://host.docker.internal:8000/api/webhooks/n8n/error
