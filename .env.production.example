APP_NAME="Wedding Matching App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://wedding-app.oldev.site
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Public demo: sample data, test checkout, demo logins on the login pages.
WEDDING_DEMO_MODE=true
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,app_structured
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=wedding_prod
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.wedding-app.oldev.site
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

CHARGILY_API_KEY=
CHARGILY_SECRET_KEY=
CHARGILY_WEBHOOK_SECRET=
CHARGILY_MODE=live

# Sentry — install sentry/sentry-laravel first, then set DSN below
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

WEDDING_UNLOCK_COST=1
WEDDING_ROUND_TIMEOUT_MINUTES=120
WEDDING_PROVIDERS_PER_ROUND=3
WEDDING_RETENTION_DAYS=14

# Shared secret for outbound webhook signing AND the inbound n8n error-webhook token.
# Must match the WEDDING_WEBHOOK_SECRET set in n8n. Generate a 32+ char random hex.
WEDDING_WEBHOOK_SECRET=

# Initial admin (AdminUserSeeder). If ADMIN_PASSWORD is blank in production, a strong
# random password is generated and printed once during db:seed.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME="Wedding Matching Admin"
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
