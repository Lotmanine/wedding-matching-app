APP_NAME="Zawaj Pro"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://zawajpro.dz
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Algiers

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,zawaj_structured
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=zawaj_prod
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.zawajpro.dz
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@zawajpro.dz"
MAIL_FROM_NAME="${APP_NAME}"

CHARGILY_API_KEY=
CHARGILY_SECRET_KEY=
CHARGILY_WEBHOOK_SECRET=
CHARGILY_MODE=live

# Sentry — install sentry/sentry-laravel first, then set DSN below
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

ZAWAJ_UNLOCK_COST=1
ZAWAJ_ROUND_TIMEOUT_MINUTES=120
ZAWAJ_PROVIDERS_PER_ROUND=3
ZAWAJ_RETENTION_DAYS=14

VITE_APP_NAME="${APP_NAME}"
